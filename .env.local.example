# Copy to .env.local and fill in. Never commit .env.local.

# --- Sanity (Phase 0) ---
# Create a free project at https://www.sanity.io/manage, then read these off it.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional at Phase 0. Needed later for draft previews (a read token from the project's API tab).
SANITY_API_READ_TOKEN=

# --- Revalidation (Phase 1) ---
# Any long random string; the same value is set on the Sanity webhook.
SANITY_REVALIDATE_SECRET=

# --- CRM (Phase 1) ---
# HubSpot private app token. Left blank, the CRM adapter runs in no-op mode.
# Scopes: crm.objects.contacts.read + crm.objects.contacts.write.
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Diagnostic (Phase C) ---
# Supabase project that stores diagnostic submissions. Server-side only; the
# service-role key bypasses RLS (the table has no public policies). Run
# supabase/migrations/0001_diagnostic_submissions.sql in the project first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# OpenAI (ChatGPT) generates the gated, personalised diagnostic. Without a key
# the result falls back to a deterministic read (never blocks). Optional model
# override; defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to "true" once Supabase + OpenAI are configured to switch the diagnostic
# result from the plain "Talk to us" CTA to the email-gate capture form.
NEXT_PUBLIC_DIAGNOSTIC_CAPTURE=

# --- Contact form (Resend) ---
# Contact form delivery. Without RESEND_API_KEY the form returns a truthful
# "mail service unavailable" rather than a fake success.
RESEND_API_KEY=
# Optional overrides (sensible defaults are used if blank):
CONTACT_TO_EMAIL=info@commview.co.uk
CONTACT_FROM_EMAIL=Commview website <website@commview.co.uk>

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.commview.co.uk
